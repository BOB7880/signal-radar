<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zijinai.signal-radar</string>
  <key>ProgramArguments</key>
  <array><string>__REPO_ROOT__/scripts/run_codex_daily.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>FEISHU_CHAT_ID</key><string>oc_REPLACE_WITH_CONFIRMED_CHAT_ID</string>
    <key>LARK_IDENTITY</key><string>user</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CODEX_BIN</key><string>/REPLACE/WITH/ABSOLUTE/PATH/TO/codex</string>
    <key>LARK_CLI_BIN</key><string>/REPLACE/WITH/ABSOLUTE/PATH/TO/lark-cli</string>
  </dict>
  <key>StandardOutPath</key><string>__REPO_ROOT__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_ROOT__/logs/launchd.err.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
